<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
	<system>
		<section id="agentic_commerce" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
            <class>separator-top</class>
			<label>Agentic Commerce</label>
			<tab>magebit</tab>
			<resource>Magebit_AgenticCommerce::config_settings</resource>
			<group id="general_settings" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>General Settings</label>
				<field id="enable_feed" type="select" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Enable Feed</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
				</field>
				<field id="marketing_consent_subscribes" translate="label comment" type="select" sortOrder="25" showInWebsite="1" showInStore="1" showInDefault="1">
					<label>Act On Marketing Consent</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
					<comment>When enabled, an opt-in reported by the agent creates a Magento newsletter subscriber and an opt-out removes one. The decision is always recorded against the order either way. Leave disabled if consent relayed by a third party is not enough for you, or if your own confirmation flow should stay the only way someone is subscribed.</comment>
				</field>
				<field id="enable_checkout" type="select" sortOrder="20" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Enable Checkout</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enable_feed">1</field>
                    </depends>
				</field>
			</group>

            <group id="agentic_checkout" sortOrder="30" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>Agentic Checkout</label>
                <field id="router_base_path" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Router Base Path</label>
                    <comment>Base path to use for the router. Default is `checkout_sessions`</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="api_token" type="obscure" sortOrder="20" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>API Token</label>
                    <comment>Leave empty to skip Bearer token validation</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="order_success_page" type="text" sortOrder="30" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Order Success Page</label>
                    <validate>required-entry</validate>
                </field>
                <field id="session_links" type="text" sortOrder="40" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Checkout Session Links</label>
                    <comment>List of links (e.g. ToS/privacy policy/etc.) to be displayed to the customer. List of links (e.g. ToS/privacy policy/etc.) to be displayed to the customer</comment>
                    <frontend_model>Magebit\AgenticCommerce\Block\Adminhtml\Form\Field\SessionLinks</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
                <field id="enable_webhooks" type="select" sortOrder="50" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Enable Webhooks</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="webhook_url" type="text" sortOrder="60" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Webhook URL</label>
                    <comment>URL to send webhooks to</comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enable_webhooks">1</field>
                    </depends>
                </field>
                <field id="webhook_secret" type="obscure" sortOrder="70" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Webhook Secret</label>
                    <comment>Secret to use for the webhook</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="enable_webhooks">1</field>
                    </depends>
                </field>
                <field id="order_status_map" translate="label" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Order Status Mapping</label>
                    <comment>Map Magento order statuses to Agentic Commerce order statuses for webhooks</comment>
                    <frontend_model>Magebit\AgenticCommerce\Block\Adminhtml\Form\Field\OrderStatusMap</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
			</group>

            <group id="product_feed" sortOrder="30" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>Product Feed</label>
				<field id="gtin_source" type="select" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>GTIN Source</label>
					<source_model>Magebit\AgenticCommerce\Model\Config\Source\GtinSource</source_model>
                    <comment>Source attribute to use for GTIN</comment>
				</field>
                <field id="seller_name_source" type="select" sortOrder="20" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Seller Name</label>
					<source_model>Magebit\AgenticCommerce\Model\Config\Source\SellerName</source_model>
				</field>
                <field id="seller_name" type="text" sortOrder="30" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Seller Name Value</label>
                    <comment>Seller name to use for the feed</comment>
                    <depends>
                        <field id="seller_name_source">custom</field>
                    </depends>
                </field>
                <field id="seller_privacy_policy_url" type="text" sortOrder="40" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Seller Privacy Policy URL</label>
                    <comment>Seller privacy policy URL to use for the feed. Can be a full URL or a relative path. Required if checkout is enabled.</comment>
                </field>
                <field id="seller_tos_url" type="text" sortOrder="50" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Seller Terms of Service URL</label>
                    <comment>Seller terms of service URL to use for the feed. Can be a full URL or a relative path. Required if checkout is enabled.</comment>
                </field>
                <field id="return_policy_url" type="text" sortOrder="60" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Return Policy URL</label>
                    <comment>Return policy URL to use for the feed. Can be a full URL or a relative path.</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="return_window" type="text" sortOrder="70" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>Return Window</label>
                    <comment>Days allowed for return</comment>
                    <validate>required-entry validate-digits validate-zero-or-greater</validate>
                </field>
			</group>

            <group id="idempotency" sortOrder="40" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>Idempotency</label>
                <field id="ttl" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                    <label>TTL</label>
                    <comment>Time to live for idempotency. Default is `24 hours`</comment>
                    <validate>required-entry validate-digits validate-zero-or-greater</validate>
                </field>
			</group>
		</section>
	</system>
</config>
