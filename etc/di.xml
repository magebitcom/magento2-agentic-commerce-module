<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magebit\AgenticCommerce\Api\ConfigInterface" type="Magebit\AgenticCommerce\Model\Config" />
    <preference for="Magebit\AgenticCommerce\Api\Data\FeedProductInterface" type="Magebit\AgenticCommerce\Model\Data\Feed\Product" />
    <preference for="Magebit\AgenticCommerce\Api\ProductMapperInterface" type="Magebit\AgenticCommerce\Model\Mapping\MapperComposite" />
    <preference for="Magebit\AgenticCommerce\Api\ProductFeedWriterInterface" type="Magebit\AgenticCommerce\Model\Export\Writer\CsvWriter" />
    <preference for="Magebit\AgenticCommerce\Model\Config\ProductFeedMapping\DataInterface" type="Magebit\AgenticCommerce\Model\Config\ProductFeedMapping\Data" />
    <preference for="Magebit\AgenticCommerce\Api\CartValidatorInterface" type="Magebit\AgenticCommerce\Model\Validation\CartValidatorComposite" />

    <!-- Request Interfaces -->
    <preference for="Magebit\AgenticCommerce\Api\Data\Request\CreateCheckoutSessionRequestInterface" type="Magebit\AgenticCommerce\Model\Data\Request\CreateCheckoutSessionRequest" />
    <preference for="Magebit\AgenticCommerce\Api\Data\Request\UpdateCheckoutSessionRequestInterface" type="Magebit\AgenticCommerce\Model\Data\Request\UpdateCheckoutSessionRequest" />
    <preference for="Magebit\AgenticCommerce\Api\Data\Request\CompleteCheckoutSessionRequestInterface" type="Magebit\AgenticCommerce\Model\Data\Request\CompleteCheckoutSessionRequest" />
    <preference for="Magebit\AgenticCommerce\Api\Data\Request\DelegatePaymentRequestInterface" type="Magebit\AgenticCommerce\Model\Data\Request\DelegatePaymentRequest" />

    <!-- Supporting Data Interfaces -->
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\AddressInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Address" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\BuyerInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Buyer" />
    <preference for="Magebit\AgenticCommerce\Api\Data\ItemInterface" type="Magebit\AgenticCommerce\Model\Data\Item" />
    <preference for="Magebit\AcpSpec\Api\DelegatePayment\PaymentMethodCardInterface" type="Magebit\AcpSpec\Data\DelegatePayment\PaymentMethodCard" />
    <preference for="Magebit\AcpSpec\Api\DelegatePayment\AllowanceInterface" type="Magebit\AcpSpec\Data\DelegatePayment\Allowance" />
    <preference for="Magebit\AcpSpec\Api\DelegatePayment\RiskSignalInterface" type="Magebit\AcpSpec\Data\DelegatePayment\RiskSignal" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\LineItemInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\LineItem" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\TotalInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Total" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\PaymentDataInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\PaymentData" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\OrderInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Order" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\LinkInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Link" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\MessageInfoInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\MessageInfo" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\MessageErrorInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\MessageError" />

    <!-- Fulfillment Option Interfaces -->
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\FulfillmentOptionShippingInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\FulfillmentOptionShipping" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\FulfillmentOptionDigitalInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\FulfillmentOptionDigital" />

    <!-- Spec types the module builds through a factory but had no preference for, so every endpoint
         that emitted one raised "cannot instantiate interface" at runtime. -->
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\FulfillmentDetailsInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\FulfillmentDetails" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\SelectedFulfillmentOptionInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\SelectedFulfillmentOption" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\CapabilitiesInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Capabilities" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\ItemInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Item" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\PaymentInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\Payment" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\PaymentHandlerInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\PaymentHandler" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\DiscoveryResponseInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\DiscoveryResponse" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\DiscoveryProtocolInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\DiscoveryProtocol" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\DiscoveryCapabilitiesInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\DiscoveryCapabilities" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\PaymentDataInstrumentInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\PaymentDataInstrument" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\PaymentDataInstrumentCredentialInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\PaymentDataInstrumentCredential" />

    <!-- Response Interfaces -->
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\CheckoutSessionInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\CheckoutSession" />
    <preference for="Magebit\AcpSpec\Api\AgenticCheckout\CheckoutSessionWithOrderInterface" type="Magebit\AcpSpec\Data\AgenticCheckout\CheckoutSessionWithOrder" />
    <preference for="Magebit\AgenticCommerce\Api\Data\Response\ErrorResponseInterface" type="Magebit\AgenticCommerce\Model\Data\Response\ErrorResponse" />
    <preference for="Magebit\AcpSpec\Api\DelegatePayment\DelegatePaymentResponseInterface" type="Magebit\AcpSpec\Data\DelegatePayment\DelegatePaymentResponse" />

    <!-- Webhook Interfaces -->
    <preference for="Magebit\AgenticCommerce\Api\Data\Webhook\WebhookEventInterface" type="Magebit\AgenticCommerce\Model\Data\Webhook\WebhookEvent" />
    <preference for="Magebit\AgenticCommerce\Api\Data\Webhook\EventDataInterface" type="Magebit\AgenticCommerce\Model\Data\Webhook\EventData" />
    <preference for="Magebit\AgenticCommerce\Api\Data\Webhook\RefundInterface" type="Magebit\AgenticCommerce\Model\Data\Webhook\Refund" />

    <!-- Custom Loggers -->
    <virtualType name="Magebit\AgenticCommerce\Logger\Handler\AgenticCommerceHandler" type="Magebit\AgenticCommerce\Logger\Handler\AgenticCommerce">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </virtualType>

    <virtualType name="Magebit\AgenticCommerce\Logger\Handler\AgenticCommerceWebhooksHandler" type="Magebit\AgenticCommerce\Logger\Handler\AgenticCommerceWebhooks">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </virtualType>

    <virtualType name="Magebit\AgenticCommerce\Logger\AgenticCommerceLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">agentic_commerce</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Magebit\AgenticCommerce\Logger\Handler\AgenticCommerceHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="Magebit\AgenticCommerce\Logger\AgenticCommerceWebhooksLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">agentic_commerce_webhooks</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Magebit\AgenticCommerce\Logger\Handler\AgenticCommerceWebhooksHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Inject Custom Logger into WebhookService -->
    <type name="Magebit\AgenticCommerce\Service\WebhookService">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceWebhooksLogger</argument>
        </arguments>
    </type>

    <!-- Inject Custom Logger into Controllers -->
    <type name="Magebit\AgenticCommerce\Controller\Checkout\Sessions\Index">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Controller\Checkout\Sessions\Update">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Controller\Checkout\Sessions\Complete">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Controller\Checkout\Sessions\Cancel">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Controller\Checkout\Sessions\Retrieve">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Controller\Delegate\Payment\Index">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>

    <!-- Inject Custom Logger into Other Services -->
    <type name="Magebit\AgenticCommerce\Service\CheckoutSessionService">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>
    <type name="Magebit\AgenticCommerce\Cron\CleanExpiredIdempotency">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>
    <type name="Magebit\AgenticCommerce\Cron\DispatchWebhooks">
        <arguments>
            <argument name="logger" xsi:type="object">Magebit\AgenticCommerce\Logger\AgenticCommerceLogger</argument>
        </arguments>
    </type>

    <!-- A preference rather than a per-consumer argument, because this is currently the only module
         with webhooks. When the other one gains them this becomes a virtual type per module. -->
    <preference for="Magebit\AgenticCore\Api\Webhook\SecretProviderInterface" type="Magebit\AgenticCommerce\Model\Webhook\SecretProvider"/>

    <virtualType name="Magebit\AgenticCommerce\Model\Config\ProductFeedMapping\SchemaLocator" type="Magento\Framework\Config\GenericSchemaLocator">
        <arguments>
            <argument name="moduleName" xsi:type="string">Magebit_AgenticCommerce</argument>
            <argument name="schema" xsi:type="string">ac_product_feed_mapping_merged.xsd</argument>
            <argument name="perFileSchema" xsi:type="string">ac_product_feed_mapping.xsd</argument>
        </arguments>
    </virtualType>

    <virtualType name="ProductFeedMappingConfigReader" type="Magento\Framework\Config\Reader\Filesystem">
        <arguments>
            <argument name="converter" xsi:type="object">Magebit\AgenticCommerce\Model\Config\ProductFeedMapping\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">Magebit\AgenticCommerce\Model\Config\ProductFeedMapping\SchemaLocator</argument>
            <argument name="fileName" xsi:type="string">ac_product_feed_mapping.xml</argument>
            <argument name="idAttributes" xsi:type="array">
                <item name="/config/attributes" xsi:type="string">product_type</item>
                <item name="/config/attributes/mapping" xsi:type="string">id</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magebit\AgenticCommerce\Model\Config\ProductFeedMapping\Data">
        <arguments>
            <argument name="reader" xsi:type="object">ProductFeedMappingConfigReader</argument>
            <argument name="cacheId" xsi:type="string">ac_product_feed_mapping_cache</argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Model\PaymentHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="stripe" xsi:type="object">Magebit\AgenticCommerce\Model\Payment\StripePaymentsHandler</item>
            </argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Model\Validation\CartValidatorComposite">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="shipping_address" xsi:type="object">Magebit\AgenticCommerce\Model\Validation\ShippingAddressValidator</item>
                <item name="customer" xsi:type="object">Magebit\AgenticCommerce\Model\Validation\CustomerValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Magebit\AgenticCommerce\Model\Writer\CsvWriter">
        <arguments>
            <argument name="feedFilePath" xsi:type="string">export/agentic_commerce.csv</argument>
        </arguments>
    </type>

	<type name="Magento\Framework\Console\CommandList">
		<arguments>
			<argument name="commands" xsi:type="array">
				<item name="ExportFeed" xsi:type="object">Magebit\AgenticCommerce\Console\Command\ExportFeed</item>
			</argument>
		</arguments>
	</type>

    <type name="Magebit\AgenticCommerce\Model\Mapping\MapperComposite">
        <arguments>
            <argument name="productTypeMappers" xsi:type="array">
                <item name="simple" xsi:type="object">Magebit\AgenticCommerce\Model\Mapping\SimpleProductMapper</item>
                <item name="configurable" xsi:type="object">Magebit\AgenticCommerce\Model\Mapping\ConfigurableProductMapper</item>
            </argument>
        </arguments>
    </type>
</config>
